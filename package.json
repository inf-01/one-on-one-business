{
  "name": "one-on-one-business",
  "version": "2.0.0",
  "private": true,
  "description": "One on One Business — calendario semanal, dashboard y data room (José & Luis)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vercel/node": "^29.0.1",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
