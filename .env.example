# ============================================================
# ONE ON ONE BUSINESS — Variables de entorno (plantilla)
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env (solo para desarrollo local)
#   2. En producción, define estas variables en el panel de Vercel:
#      Settings → Environment Variables
#   ⚠️  NUNCA subas .env al repositorio (ya está en .gitignore)
# ============================================================

# --- Google Apps Script ---
# URL de la app web desplegada (termina en /exec)
GAS_URL=https://script.google.com/macros/s/XXXXX/exec

# Clave secreta compartida entre Vercel y Google Apps Script (Code.gs → API_KEY)
# Usa una cadena larga y aleatoria, ej: openssl rand -hex 32
API_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# --- Gemini AI (para procesar minutas) ---
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo a usar (opcional, por defecto: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Supabase (opcional, para el Data Room) ---
# Si no se configura, el Data Room queda deshabilitado (el resto funciona igual)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
